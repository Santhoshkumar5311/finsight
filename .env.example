# Copy to .env in finsight/. Demo needs no external services; never deploy demo publicly.
APP_MODE=demo
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://finsight:localdev@127.0.0.1:5432/finsight
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://finsight:localdev@127.0.0.1:5672
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
# India Account Aggregator sandbox mock only (see docs/INDIA_BANKING.md) — no real TSP/FIU
# integration exists. Must stay false/unset outside local development; config.js refuses to
# start with this true when NODE_ENV=production.
AA_SANDBOX_ENABLED=false
OPENAI_API_KEY=
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
AUDIO_BUCKET=
# Generate with: openssl rand -hex 32. Use a secrets manager in live deployments.
PII_TOKEN_KEY=
CHECKSUM_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Supply NEXT_PUBLIC_* in apps/web/.env.local (read at Next build time).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private Presidio analyzer endpoint. Required in live mode; never a public untrusted URL.
PII_ANALYZER_URL=http://127.0.0.1:5002
EXPO_ACCESS_TOKEN=

# Local model (optional; no hosted AI key required)
LOCAL_AI_ENABLED=false
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen3:8b
# Optional separate encrypted personal workspace, relative to repository root
# DEMO_DATA_FILE=.data/personal.json
# Production deployment values: infra/production.env.example
