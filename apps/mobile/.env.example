EXPO_PUBLIC_MODE=demo
# iOS simulator can use localhost. Physical devices need an HTTPS development tunnel.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Two base64 SHA-256 SPKI pins: current and backup. Native development build required.
EXPO_PUBLIC_API_PIN_CURRENT=
EXPO_PUBLIC_API_PIN_BACKUP=
EXPO_PUBLIC_EAS_PROJECT_ID=
